flowchart TD
  A([Начало раздачи]) --> B["Сдвиг фишки дилера, постановка блайндов"]
  B --> C["Тасование колоды, раздача карманных карт"]
  C --> D["Круг торговли"]
  D --> E{"Действие получено до истечения времени?"}
  E -- да --> F{"Действие допустимо?"}
  F -- нет --> D
  F -- да --> G["Применение действия, рассылка состояния"]
  E -- нет --> H["Банк времени или автоматическое действие"]
  H --> G
  G --> I{"Остался один игрок?"}
  I -- да --> N["Выплата банка"]
  I -- нет --> J{"Круг торговли завершён?"}
  J -- нет --> D
  J -- да --> K{"Это ривер?"}
  K -- нет --> L["Открытие следующих общих карт"]
  L --> D
  K -- да --> M["Вскрытие: оценка комбинаций, побочные банки"]
  M --> N
  N --> O["Обновление стеков и статистики"]
  O --> P["Сохранение истории раздачи"]
  P --> Q([Конец раздачи])
