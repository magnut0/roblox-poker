  state "Постановка блайндов (BLINDS)" as Blinds
  state "Префлоп (PREFLOP)" as Preflop
  state "Флоп (FLOP)" as Flop
  state "Тёрн (TURN)" as Turn
  state "Ривер (RIVER)" as River
