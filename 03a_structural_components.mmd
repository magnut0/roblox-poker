    ProfileService["ProfileService<br/>сервис профилей"]
    AdminService["AdminService<br/>сервис администрирования"]
    AuditLogger["AuditLogger<br/>журнал аудита"]
    BackupJob["BackupJob<br/>резервное копирование"]
  end
