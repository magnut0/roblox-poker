flowchart TB
  subgraph CLIENT["Клиент Roblox"]
    LobbyUI["LobbyUI<br/>интерфейс лобби"]
    TableUI["TableUI<br/>интерфейс стола"]
    ChatUI["ChatUI<br/>интерфейс чата"]
    AdminUI["AdminUI<br/>интерфейс администратора"]
  end
